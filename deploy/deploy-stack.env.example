# Copy to deploy-stack.env and edit (deploy-stack.env is gitignored).
# Used by deploy/deploy-stack.sh (Git Bash / WSL / macOS / Linux)
# and deploy/deploy-stack.ps1 (Windows PowerShell).

AWS_REGION=us-east-1
STACK_NAME=j-answer-app
DOMAIN=j-answer.kylemeister.dev

# Path to your SQLite file on this machine (for optional upload step).
DB_PATH=./j-answer.db

# SSH private key for scp (optional upload). PowerShell: use $env:USERPROFILE\.ssh\id_ed25519
SSH_KEY_PATH=~/.ssh/id_ed25519

# CloudFormation overrides (leave empty for template defaults).
VPC_ID=
SUBNET_ID=
INSTANCE_TYPE=t4g.small
ROOT_VOLUME_GIB=16
REPO_URL=https://github.com/kylemaestro/j-answer.git
REPO_REF=master
KEY_NAME=
HOSTED_ZONE_ID=
ALLOW_SSH_FROM_INTERNET=true

# Set true in deploy-stack.env to run scp after the stack is up (needs KEY_NAME or authorized_keys on the instance).
UPLOAD_DB=false
