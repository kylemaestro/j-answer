# Copy to e.g. /etc/nginx/conf.d/janswer.conf and adjust paths.
# Obtain TLS: sudo certbot --nginx -d j-answer.kylemeister.dev
#
# Layout:
#   /opt/j-answer/web/dist  — Vite build output (root of site)
#   /opt/j-answer/app       — Python app (src/, janswer/, requirements.txt)
#   /opt/j-answer/data/j-answer.db — SQLite (JANSWER_DB)

server {
    listen 80;
    listen [::]:80;
    server_name j-answer.kylemeister.dev;
    # After certbot, it will add SSL server blocks; keep this for ACME renewals.

    root /opt/j-answer/web/dist;
    index index.html;

    # SPA: unknown paths → index.html (Vite client-side routes if you add any)
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
